{
  "name": "repodoctor",
  "version": "0.1.0",
  "description": "Diagnose your project before you waste time debugging it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repodoctor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
